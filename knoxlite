<script>
  // Night vision toggle
  const toggle = document.getElementById('nvToggle');
  toggle.addEventListener('click', () => {
    document.body.classList.toggle('nv-on');
  });

  // Countdown timer
  const targetTime = Date.now() + (2 * 24 * 60 * 60 * 1000) + (14 * 60 * 60 * 1000) + (37 * 60 * 1000) + (22 * 1000);
  const dEl = document.getElementById('d-d');
  const hEl = document.getElementById('d-h');
  const mEl = document.getElementById('d-m');
  const sEl = document.getElementById('d-s');

  function pad(n) { return String(Math.max(0, n)).padStart(2, '0'); }
  function tick() {
    let diff = targetTime - Date.now();
    if (diff < 0) diff = 0;
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hrs  = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const mins = Math.floor((diff / (1000 * 60)) % 60);
    const secs = Math.floor((diff / 1000) % 60);
    dEl.textContent = pad(days);
    hEl.textContent = pad(hrs);
    mEl.textContent = pad(mins);
    sEl.textContent = pad(secs);
  }
  tick();
  setInterval(tick, 1000);

  // Buy buttons
  document.querySelectorAll('.btn-buy').forEach(btn => {
    btn.addEventListener('click', () => {
      const original = btn.textContent;
      btn.textContent = 'Authenticating Operator...';
      setTimeout(() => {
        btn.textContent = '✓ Added to Loadout';
        setTimeout(() => btn.textContent = original, 1800);
      }, 700);
    });
  });
</script>

