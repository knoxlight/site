<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KNOX LIGHT™ — Tactical Night Vision for the Discerning Operator</title>
<meta name="description" content="Premium tactical night vision optics. As issued to elite units, suburban dads, and one extremely paranoid raccoon.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Oswald:wght@400;500;600;700&family=Special+Elite&family=DM+Sans:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
<style>
  :root {
    --olive-deep: #0a0f06;
    --olive: #131a0c;
    --olive-mid: #1c2611;
    --olive-light: #2c3a18;
    --bone: #f1ecde;
    --bone-dim: #b8b09a;
    --bone-faint: #6e6a5a;
    --nv-green: #4ade80;
    --nv-green-bright: #a7f3a7;
    --nv-green-deep: #15803d;
    --signal: #ff6b1a;
    --signal-deep: #c2410c;
    --warning: #fbbf24;
    --redacted: #0a0a08;
    --blood: #7f1d1d;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--olive-deep);
    color: var(--bone);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
    background-image:
      radial-gradient(circle at 20% 10%, rgba(74, 222, 128, 0.04), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(255, 107, 26, 0.03), transparent 50%);
    min-height: 100vh;
  }

  /* Subtle film grain overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1000;
    opacity: 0.06;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* Night vision toggle effect */
  body.nv-on {
    filter: hue-rotate(70deg) saturate(2.2) brightness(0.85) contrast(1.4);
  }
  body.nv-on::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    background:
      radial-gradient(circle at 50% 50%, transparent 30%, rgba(0,0,0,0.45) 100%),
      repeating-linear-gradient(0deg, rgba(0,0,0,0.18) 0px, transparent 1px, transparent 3px);
    animation: nv-flicker 0.16s infinite;
  }
  @keyframes nv-flicker {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
  }

  /* TICKER */
  .ticker {
    background: var(--signal);
    color: var(--olive-deep);
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 13px;
    padding: 8px 0;
    overflow: hidden;
    border-bottom: 2px solid var(--olive-deep);
    position: relative;
    z-index: 10;
  }
  .ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: scroll 70s linear infinite;
    gap: 48px;
    padding-left: 100%;
  }
  .ticker-track span::before {
    content: '◆';
    margin-right: 12px;
    color: var(--olive-deep);
  }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }

  /* HEADER */
  header {
    background: var(--olive-deep);
    border-bottom: 1px solid var(--olive-light);
    padding: 18px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'Black Ops One', cursive;
    font-size: 26px;
    letter-spacing: 0.04em;
    color: var(--bone);
    text-decoration: none;
  }
  .logo .reticle {
    width: 32px;
    height: 32px;
    border: 2px solid var(--nv-green);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }
  .logo .reticle::before, .logo .reticle::after {
    content: '';
    position: absolute;
    background: var(--nv-green);
  }
  .logo .reticle::before {
    width: 2px; height: 20px;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
  }
  .logo .reticle::after {
    width: 20px; height: 2px;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
  }
  .logo-tm {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: var(--bone-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 13px;
  }
  nav a {
    color: var(--bone-dim);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
  }
  nav a:hover {
    color: var(--nv-green-bright);
    text-shadow: 0 0 12px var(--nv-green);
  }

  .nv-toggle {
    background: transparent;
    border: 1px solid var(--nv-green-deep);
    color: var(--nv-green);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }
  .nv-toggle:hover {
    background: var(--nv-green-deep);
    color: var(--bone);
    box-shadow: 0 0 24px var(--nv-green-glow);
  }
  .nv-toggle .dot {
    width: 8px; height: 8px;
    background: var(--bone-faint);
    border-radius: 50%;
    transition: all 0.2s;
  }
  body.nv-on .nv-toggle .dot {
    background: var(--nv-green-bright);
    box-shadow: 0 0 12px var(--nv-green);
  }

  /* HERO */
  .hero {
    padding: 100px 40px 80px;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }

  .hero::before {
    content: 'CLASSIFIED // DECLASSIFIED // RECLASSIFIED // FOR YOUR EYES ONLY';
    position: absolute;
    top: 30px;
    right: 40px;
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    color: var(--blood);
    letter-spacing: 0.15em;
    transform: rotate(-2deg);
    border: 1px solid var(--blood);
    padding: 4px 10px;
  }

  .eyebrow {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 13px;
    color: var(--signal);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .eyebrow::before {
    content: '';
    width: 36px; height: 2px;
    background: var(--signal);
  }

  h1 {
    font-family: 'Black Ops One', cursive;
    font-size: clamp(48px, 6vw, 82px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin-bottom: 24px;
    text-transform: uppercase;
  }
  h1 .highlight {
    color: var(--nv-green);
    text-shadow: 0 0 30px var(--nv-green-glow);
    font-style: italic;
  }
  h1 .strike {
    text-decoration: line-through;
    color: var(--bone-faint);
    font-size: 0.6em;
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
    text-transform: lowercase;
    font-weight: 400;
  }

  .hero p.lead {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    line-height: 1.45;
    color: var(--bone-dim);
    margin-bottom: 36px;
    max-width: 540px;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    font-size: 14px;
    padding: 18px 32px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.25s;
    position: relative;
  }
  .btn-primary {
    background: var(--signal);
    color: var(--olive-deep);
    border: 2px solid var(--signal);
  }
  .btn-primary:hover {
    background: var(--bone);
    border-color: var(--bone);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--signal);
  }
  .btn-secondary {
    background: transparent;
    color: var(--bone);
    border: 2px solid var(--olive-light);
  }
  .btn-secondary:hover {
    border-color: var(--nv-green);
    color: var(--nv-green-bright);
  }

  .hero-trust {
    display: flex;
    gap: 24px;
    margin-top: 40px;
    font-family: 'Special Elite', monospace;
    font-size: 12px;
    color: var(--bone-faint);
    flex-wrap: wrap;
  }
  .hero-trust span { display: flex; align-items: center; gap: 6px; }
  .hero-trust span::before { content: '✓'; color: var(--nv-green); }

  /* Hero illustration: night vision goggles SVG */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 480px;
  }
  .hero-visual svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    filter: drop-shadow(0 30px 80px rgba(74, 222, 128, 0.15));
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .hero-visual::before {
    content: '';
    position: absolute;
    width: 80%; height: 80%;
    background: radial-gradient(circle, var(--nv-green-glow), transparent 70%);
    z-index: -1;
    animation: pulse 4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.95); }
    50% { opacity: 0.7; transform: scale(1.05); }
  }
  .hero-tag {
    position: absolute;
    background: var(--olive-mid);
    border: 1px solid var(--nv-green-deep);
    color: var(--nv-green-bright);
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    padding: 6px 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero-tag::before {
    content: '';
    position: absolute;
    background: var(--nv-green);
  }
  .tag-1 {
    top: 8%; right: 0;
  }
  .tag-1::before {
    width: 60px; height: 1px;
    right: 100%; top: 50%;
  }
  .tag-2 {
    bottom: 18%; left: 0;
  }
  .tag-2::before {
    width: 60px; height: 1px;
    left: 100%; top: 50%;
  }
  .tag-3 {
    top: 45%; right: -10px;
  }
  .tag-3::before {
    width: 40px; height: 1px;
    right: 100%; top: 50%;
  }

  /* AS FEATURED IN */
  .featured {
    background: var(--olive);
    border-top: 1px solid var(--olive-light);
    border-bottom: 1px solid var(--olive-light);
    padding: 36px 40px;
  }
  .featured-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 60px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .featured-label {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 12px;
    color: var(--bone-faint);
  }
  .featured-logos {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .featured-logo {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    color: var(--bone-dim);
    opacity: 0.7;
    letter-spacing: 0.02em;
  }
  .featured-logo.bold {
    font-family: 'Black Ops One', cursive;
    font-style: normal;
    font-size: 18px;
    letter-spacing: 0.04em;
  }
  .featured-logo .small {
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    display: block;
    color: var(--bone-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* SECTION BASICS */
  section.content {
    padding: 100px 40px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }
  .section-header {
    margin-bottom: 64px;
    max-width: 720px;
  }
  h2 {
    font-family: 'Black Ops One', cursive;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    letter-spacing: 0.01em;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  h2 .accent { color: var(--nv-green); }
  h3 {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .section-sub {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 20px;
    color: var(--bone-dim);
    line-height: 1.5;
  }

  /* PRODUCTS */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 28px;
  }
  .product {
    background: var(--olive);
    border: 1px solid var(--olive-light);
    padding: 28px;
    position: relative;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
  }
  .product:hover {
    border-color: var(--nv-green-deep);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 40px var(--nv-green-glow);
  }
  .product-badge {
    position: absolute;
    top: -10px; right: 20px;
    background: var(--signal);
    color: var(--olive-deep);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    padding: 5px 12px;
    transform: rotate(2deg);
  }
  .product-badge.green { background: var(--nv-green); }
  .product-badge.warning { background: var(--warning); transform: rotate(-2deg); }

  .product-image {
    background: var(--olive-deep);
    border: 1px solid var(--olive-mid);
    padding: 24px;
    margin-bottom: 24px;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .product-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, transparent, transparent 19px, rgba(74,222,128,0.05) 20px),
      repeating-linear-gradient(90deg, transparent, transparent 19px, rgba(74,222,128,0.05) 20px);
  }
  .product-image::after {
    content: 'KL-NX';
    position: absolute;
    bottom: 8px; right: 12px;
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    color: var(--nv-green-deep);
    letter-spacing: 0.15em;
  }
  .product-image svg {
    width: 70%;
    max-width: 200px;
    height: auto;
    filter: drop-shadow(0 0 24px var(--nv-green-glow));
    transition: transform 0.4s;
  }
  .product:hover .product-image svg { transform: scale(1.08) rotate(-2deg); }

  .product-meta {
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    color: var(--nv-green);
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }
  .product-name {
    font-family: 'Black Ops One', cursive;
    font-size: 22px;
    line-height: 1.1;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .product-desc {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--bone-dim);
    margin-bottom: 18px;
    line-height: 1.4;
    flex-grow: 1;
  }
  .product-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
    border-top: 1px solid var(--olive-light);
    padding-top: 16px;
    margin-bottom: 20px;
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    color: var(--bone-faint);
    letter-spacing: 0.04em;
  }
  .product-specs span:nth-child(odd) { color: var(--bone-dim); }
  .product-specs span:nth-child(even) { color: var(--nv-green); text-align: right; }

  .product-price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
  }
  .price-now {
    font-family: 'Black Ops One', cursive;
    font-size: 32px;
    color: var(--bone);
  }
  .price-was {
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    color: var(--bone-faint);
    text-decoration: line-through;
  }
  .price-save {
    font-family: 'Oswald', sans-serif;
    font-size: 11px;
    background: var(--blood);
    color: var(--bone);
    padding: 3px 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .btn-buy {
    background: var(--olive-deep);
    color: var(--bone);
    border: 1px solid var(--nv-green-deep);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 13px;
    font-weight: 600;
    padding: 14px;
    cursor: pointer;
    width: 100%;
    transition: all 0.2s;
  }
  .btn-buy:hover {
    background: var(--nv-green-deep);
    color: var(--bone);
    box-shadow: inset 0 0 30px rgba(0,0,0,0.4);
  }

  /* COMPARISON */
  .comparison {
    background: var(--olive);
    margin-top: 40px;
  }
  .compare-wrap {
    padding: 80px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .compare-table {
    border: 1px solid var(--olive-light);
    background: var(--olive-deep);
    margin-top: 40px;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'DM Sans', sans-serif;
    min-width: 600px;
  }
  th, td {
    padding: 18px 20px;
    text-align: left;
    border-bottom: 1px solid var(--olive-light);
  }
  th {
    background: var(--olive-mid);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    color: var(--bone-dim);
  }
  th.us {
    background: var(--olive-light);
    color: var(--nv-green-bright);
  }
  td.us {
    color: var(--nv-green-bright);
    font-weight: 700;
    background: rgba(74, 222, 128, 0.04);
  }
  td.them {
    color: var(--bone-faint);
    font-style: italic;
  }
  td:first-child {
    font-family: 'Special Elite', monospace;
    font-size: 13px;
    color: var(--bone-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* TESTIMONIALS */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }
  .testimonial {
    background: var(--olive);
    padding: 32px;
    border-left: 3px solid var(--nv-green);
    position: relative;
  }
  .testimonial:nth-child(2) { border-color: var(--signal); }
  .testimonial:nth-child(3) { border-color: var(--warning); }
  .testimonial:nth-child(4) { border-color: var(--blood); }
  .testimonial::before {
    content: '"';
    position: absolute;
    top: 8px;
    right: 24px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 100px;
    color: var(--olive-light);
    line-height: 1;
  }
  .stars {
    color: var(--warning);
    letter-spacing: 0.1em;
    margin-bottom: 14px;
    font-size: 14px;
  }
  .testimonial blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 19px;
    line-height: 1.5;
    color: var(--bone);
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--olive-light);
    padding-top: 16px;
  }
  .author-avatar {
    width: 44px; height: 44px;
    background: var(--olive-light);
    border: 1px solid var(--nv-green-deep);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Black Ops One', cursive;
    color: var(--nv-green);
    font-size: 16px;
    flex-shrink: 0;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 13px;
    color: var(--bone);
    font-weight: 600;
  }
  .author-title {
    font-family: 'Special Elite', monospace;
    font-size: 11px;
    color: var(--bone-faint);
    letter-spacing: 0.05em;
  }
